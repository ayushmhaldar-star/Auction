# ============================================================
# Cricket Auction Pro – Environment Configuration
# ============================================================

# Backend Port
PORT=5000

# MongoDB Connection String (Atlas URI or local URI)
# Note: If no Mongo server is running, the backend automatically
# spins up an embedded in-memory MongoDB for zero-config testing!
MONGODB_URI=mongodb://127.0.0.1:27017/cricket_auction_pro

# JWT Secret for Master Admin Authentication
JWT_SECRET=cricket-auction-pro-super-secret-key-2026

# Master Administrator Credentials (Seeded on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cloudinary Configuration (Optional - falls back to local uploads if left blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
